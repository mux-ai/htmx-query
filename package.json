{
  "name": "htmx-query",
  "version": "0.3.0",
  "description": "React Query-flavored caching, SWR, retry, dedupe and optimistic updates for htmx 2 and 4",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mux-ai/htmx-query.git"
  },
  "homepage": "https://github.com/mux-ai/htmx-query#readme",
  "bugs": "https://github.com/mux-ai/htmx-query/issues",
  "sideEffects": true,
  "type": "module",
  "main": "./dist/htmx-query.cjs",
  "module": "./dist/htmx-query.js",
  "types": "./src/index.d.ts",
  "unpkg": "./dist/htmx-query.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/htmx-query.d.ts",
        "default": "./dist/htmx-query.js"
      },
      "require": {
        "types": "./dist/htmx-query.d.cts",
        "default": "./dist/htmx-query.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "CHANGELOG.md",
    "LICENSE",
    "RELEASING.md",
    "llms.txt",
    "llm.txt"
  ],
  "license": "MIT",
  "keywords": [
    "htmx",
    "htmx-extension",
    "swr",
    "cache",
    "retry",
    "optimistic"
  ],
  "peerDependencies": {
    "htmx.org": ">=2.0.0 <3 || >=4.0.0-beta6 <5"
  },
  "scripts": {
    "build": "node build.js",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --project tsconfig.types.json",
    "changelog:check": "node scripts/check-changelog.js",
    "package:verify": "node scripts/verify-package.js",
    "release:verify": "node scripts/verify-release.js",
    "dev": "vitest",
    "lint": "eslint .",
    "size": "size-limit",
    "bench": "node bench/cache-benchmark.js",
    "bench:check": "node bench/cache-benchmark.js --check",
    "demo": "node examples/server.js",
    "prepublishOnly": "npm run changelog:check && npm run lint && npm run typecheck && npm run build && npm run test && npm run size"
  },
  "size-limit": [
    {
      "path": "dist/htmx-query.min.js",
      "limit": "7.5 kB"
    }
  ],
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "htmx.org": "4.0.0-beta6",
    "jsdom": "^30.0.1",
    "nise": "^6.1.5",
    "size-limit": "^12.1.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "pnpm@9.15.9"
}
